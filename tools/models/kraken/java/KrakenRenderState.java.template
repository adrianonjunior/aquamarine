package com.aquamarine.client.entity.kraken;

import net.minecraft.client.renderer.entity.state.LivingEntityRenderState;
import net.minecraft.world.entity.AnimationState;

/** Immutable-per-frame values copied from KrakenEntity before the model is submitted. */
public final class KrakenRenderState extends LivingEntityRenderState {
	public final AnimationState idle = new AnimationState();
	public final AnimationState swim = new AnimationState();
	public final AnimationState emerge = new AnimationState();
	public final AnimationState stunned = new AnimationState();
	public final AnimationState phaseChange = new AnimationState();
	public final AnimationState death = new AnimationState();
	public final AnimationState slam = new AnimationState();
	public final AnimationState grab = new AnimationState();
	public final AnimationState ink = new AnimationState();
	public final AnimationState whirlpool = new AnimationState();
	public final AnimationState spawnYoung = new AnimationState();
	public final AnimationState waterJet = new AnimationState();
	public final AnimationState roar = new AnimationState();
	public final AnimationState bolts = new AnimationState();
	public final AnimationState ambush = new AnimationState();
	public final AnimationState doubleGrab = new AnimationState();
	public int phase = 1;
	public float shieldFraction = 1.0F;
	/** Deslocamento horizontal no último tick (blocos): o modelo nada mais forte quanto mais rápido. */
	public float speed;
}
